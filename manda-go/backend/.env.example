# =============================================================
# MANDA GO API — Variables d'Environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env
# =============================================================

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# =============================================================
# BASE DE DONNÉES
# =============================================================
DATABASE_URL=postgresql://manda_user:manda_pass@localhost:5432/manda_go
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=manda_go
DATABASE_USER=manda_user
DATABASE_PASSWORD=manda_pass
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# =============================================================
# REDIS
# =============================================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL_SECONDS=3600

# =============================================================
# AUTHENTIFICATION JWT
# =============================================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_this_in_production
JWT_REFRESH_EXPIRATION=7d
BCRYPT_ROUNDS=12

# =============================================================
# OPENAI (GPT-4o + Whisper + TTS)
# =============================================================
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=nova
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# =============================================================
# STRIPE (Paiements)
# =============================================================
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PLUS_MONTHLY=price_...
STRIPE_PRICE_PLUS_YEARLY=price_...
STRIPE_PRICE_FAMILY_YEARLY=price_...
STRIPE_PRICE_LIFETIME=price_...

# =============================================================
# AWS
# =============================================================
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=manda-go-media-dev
AWS_CLOUDFRONT_URL=https://cdn.mandago.app
AWS_SES_FROM_EMAIL=noreply@mandago.app

# =============================================================
# FIREBASE (Notifications Push)
# =============================================================
FIREBASE_PROJECT_ID=manda-go-prod
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@manda-go-prod.iam.gserviceaccount.com

# =============================================================
# AZURE SPEECH (Reconnaissance vocale avancée)
# =============================================================
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=westeurope

# =============================================================
# SÉCURITÉ & LIMITES
# =============================================================
CORS_ORIGIN=http://localhost:3001,http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
RATE_LIMIT_AI_MAX=20
MAX_FILE_SIZE_MB=10
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# =============================================================
# EMAIL (AWS SES)
# =============================================================
SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=...
SMTP_PASS=...
EMAIL_FROM=noreply@mandago.app
EMAIL_REPLY_TO=support@mandago.app

# =============================================================
# ANALYTICS
# =============================================================
MIXPANEL_TOKEN=...
SENTRY_DSN=https://...@sentry.io/...

# =============================================================
# FEATURE FLAGS
# =============================================================
FEATURE_AI_ENABLED=true
FEATURE_VOICE_ENABLED=true
FEATURE_LEAGUES_ENABLED=true
FEATURE_BETA_GAMES=false
