# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-v7-YOUR_API_KEY_HERE

# Application Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=AfriLink Pro

# Database (if using)
# DATABASE_URL=postgresql://user:password@localhost:5432/afrilink

# Authentication (if implementing)
# NEXTAUTH_SECRET=your-secret-key
# NEXTAUTH_URL=http://localhost:3000

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_MATCHING=true
NEXT_PUBLIC_ENABLE_PREMIUM=true
NEXT_PUBLIC_ENABLE_MESSAGING=true

# External APIs
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...

# Logging
LOG_LEVEL=info
